qu_macro: qu_macro {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    bindings = <&kp Q &kp U>;
};

save_vim: save_vim {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    bindings
        = <&kp ESC &kp COLON &kp W &kp ENTER>
        ;
};

quit_vim: quit_vim {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    bindings
        = <&kp ESC &kp COLON &kp Q &kp ENTER>
        ;
};
