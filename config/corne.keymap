#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        bindings = <
   &none &kp UNDER &kp C    &kp F     &kp K  &kp B       &kp X     &kp J  &kp O      &kp U    &kp RPAR     &none
   &none &kp R     &kp S    &kp T     &kp H  &kp P       &kp M     &kp N  &kp A      &kp I    &key_repeat  &none
   &none &kp V     &kp W    &kp G     &kp D  &kp LPAR    &kp FSLH  &kp L  &kp COMMA  &kp DOT  &kp Y        &none
                            &kp LGUI  &mo 1  &kp SPACE   &kp E     &mo 2  &kp RALT
                        >;
                };
                lower_layer {
                        bindings = <
   &none &kp UNDER &kp C    &kp F     &kp K  &kp B       &kp X     &kp J  &kp O      &kp U    &kp RPAR     &none
   &none &kp R     &kp S    &kp T     &kp H  &kp P       &kp M     &kp N  &kp A      &kp I    &key_repeat  &none
   &none &kp V     &kp W    &kp G     &kp D  &kp LPAR    &kp FSLH  &kp L  &kp COMMA  &kp DOT  &kp Y        &none
                            &kp LGUI  &mo 1  &kp SPACE   &kp E     &mo 2  &kp RALT
                        >;
                };

                raise_layer {
                        bindings = <
   &none &kp UNDER &kp C    &kp F     &kp K  &kp B       &kp X     &kp J  &kp O      &kp U    &kp RPAR     &none
   &none &kp R     &kp S    &kp T     &kp H  &kp P       &kp M     &kp N  &kp A      &kp I    &key_repeat  &none
   &none &kp V     &kp W    &kp G     &kp D  &kp LPAR    &kp FSLH  &kp L  &kp COMMA  &kp DOT  &kp Y        &none
                            &kp LGUI  &mo 1  &kp SPACE   &kp E     &mo 2  &kp RALT
                        >;
                };
        };
};

/ {
    combos {
        compatible = "zmk,combos";
        // Letters
        combo_q {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp BSPC>;
        };
        combo_qu {
            timeout-ms = <50>;
            key-positions = <1 2>;
            bindings = <&kp Q &kp U>;
        };
        // Controls
        combo_esc {
            timeout-ms = <50>;
            key-positions = <12 21>;
            bindings = <&kp ESC>;
        };
        combo_ent {
            timeout-ms = <50>;
            key-positions = <16 17 18>;
            bindings = <&kp ENTER>;
        };
        combo_bspc {
            timeout-ms = <50>;
            key-positions = <18 19>;
            bindings = <&kp BSPC>;
        };
    };
};
