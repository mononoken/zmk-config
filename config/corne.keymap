#include <behaviors.dtsi>
#include <behaviors/num_word.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include "corne.h"
#include "zmk-helpers/helper.h"
#include "zmk-helpers/key-labels/42.h"

/* Globals */

#define QUICK_TAP_MS 175

&sk {
  release-after-ms = <900>;
  quick-release;
};

&lt {
  flavor = "balanced";
  tapping-term-ms = <200>;
  quick-tap-ms = <QUICK_TAP_MS>;
};

&num_word {
  continue-list = <BSPC DEL DOT COMMA PLUS MINUS STAR FSLH EQUAL>;
};

#define TW(keycode) &tw keycode keycode
#define RT(keycode) &rt keycode 0

/ {
        combos {
                #include "combos.dtsi"
        };

        macros {
                #include "macros.dtsi"
        };

        behaviors {
                tw: tmux_window_hold_tap {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        tapping-term-ms = <200>;
                        quick-tap-ms = <QUICK_TAP_MS>;
                        flavor = "balanced";
                        bindings = <&tmux_window>, <&kp>;
                };
                rt: repeat_tap {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        flavor = "tap-preferred";
                        tapping-term-ms = <160>;
                        bindings = <&mo>, <&key_repeat>;
                        display-name = "Repeat-Layer-Tap";
                };
        };

        keymap {
                compatible = "zmk,keymap";
                base_layer {
                        display-name = "BASE";
                        bindings = <
   &none &kp Q      &kp F       &kp D         &kp W           &kp P         &kp X        &kp M        &kp O        &kp U          &kp COMMA    &none
   &none &kp N      &kp S       &kp T         &kp C           &kp Y         &kp K        &kp H        &kp A        &kp E          &kp I        &none
   &none &sk LSHFT  &kp V       &kp B         &kp G           &kp APOS      &kp J        &kp L        &kp DOT      &kp FSLH       &sk RSHFT    &none
                                &sl SYMB      &lt NAVI SPACE  &sl SYMB      &key_repeat  &kp R        &sl SYMB
                        >;
                };
                numb_layer {
                        display-name = "NUMB";
                        bindings = <
   &none &none     &kp LBKT  &kp RBKT  &kp AT    &kp ASTRK &kp X     &kp PLUS      &kp MINUS  &kp EXCL  &trans     &none
   &none &kp N6    &kp N4    &kp N0    &kp N2    &kp LS(G) &kp K     &kp N3        &kp N1     &kp N5    &kp N7     &none
   &none &kp PRCNT &kp LT    &kp GT    &kp N8    &kp HASH  &kp J     &kp N9        &trans     &trans    &kp QMARK  &none
                             &trans    &trans    &trans    &trans    &kp K_CANCEL  &trans
                        >;
                };
                symb_layer {
                        display-name = "SYMB";
                        bindings = <
   &none &none     &kp LBKT  &kp RBKT        &kp AT    &kp ASTRK  &none     &kp PLUS      &kp MINUS  &kp EXCL  &kp TILDE    &none
   &none &kp GRAVE &kp LPAR  &kp RPAR        &kp CARET &kp BSLH   &none     &kp DOLLAR    &kp DQT    &kp LBRC  &kp RBRC     &none
   &none &kp PRCNT &kp LT    &kp GT          &kp PIPE  &kp HASH   &none     &kp AMPS      &kp UNDER  &trans    &kp QMARK    &none
                             &trans          &trans    &trans     &trans    &kp K_CANCEL  &trans
                        >;
                };
                navi_layer {
                        display-name = "NAVI";
                        bindings = <
   &none &kp LG(LS(T)) &kp LEFT        &kp UP           &kp RIGHT   &none     &kp LA(S)  &kp LA(H) &kp LA(J)  &kp LA(K) &kp LA(L) &none
   &none &kp LG(A)     &kp LC(LS(TAB)) &mt LCTRL DOWN   &kp LC(TAB) &none     &kp HOME   &kp H     &kp J      &kp K     &kp L     &none
   &none &kp LG(Z)     &kp LG(X)       &kp LG(C)        &kp LG(V)   &none     &kp END    &kp LC(D) &kp PG_DN  &kp PG_UP &kp LC(U) &none
                                       &trans           &trans      &trans    &trans     &mo WNAV  &trans
                        >;
                };
                wnav_layer {
                        display-name = "WNAV";
                        bindings = <
   &none &none      &none      &none      &none      &none   &none   TMUX_LT     TMUX_DN      TMUX_UP     TMUX_RT    &none
   &none &kp LA(N6) &kp LA(N4) &kp LA(N0) &kp LA(N2) &none   &none   &kp LA(N3)  &kp LA(N1)   &kp LA(N5)  &kp LA(N7) &none
   &none &none      &none      &none      &kp LA(N8) &none   &none   &none       &lca_w       &lca_e      &lca_m     &none
                               &trans     &trans     &trans  &trans  &trans      &trans
                        >;
                };
                medi_layer {
                        display-name = "MEDI";
                        bindings = <
   &none &none     &none     &none     &none     &none       &bt BT_CLR    &none         &kp C_PREV   &kp C_NEXT    &none       &none
   &none &none     &none     &none     &none     &none       &bt BT_SEL 0  &kp C_PP      &kp C_VOL_DN &kp C_VOL_UP  &kp C_MUTE  &none
   &none &none     &none     &none     &none     &none       &bt BT_SEL 1  &kp F13       &kp C_BRI_DN &kp C_BRI_UP  &none       &none
                             &trans    &trans    &trans      &none         &kp K_CANCEL  &trans
                        >;
                };
        };
};
