#include <behaviors.dtsi>
#include <behaviors/num_word.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include "corne.h"
#include "zmk-helpers/helper.h"
#include "zmk-helpers/key-labels/42.h"

/* Globals */

#define QUICK_TAP_MS 175

&sk {
  release-after-ms = <900>;
  quick-release;
};

&lt {
  flavor = "balanced";
  tapping-term-ms = <200>;
  quick-tap-ms = <QUICK_TAP_MS>;
};

&num_word {
  continue-list = <BSPC DEL DOT COMMA PLUS MINUS STAR FSLH EQUAL>;
};

/* Tmux pane switch on hold, yabai window swap on tap */
#define TY(keycode) &tw keycode LA(keycode)

/ {
        combos {
                #include "combos.dtsi"
        };

        macros {
                #include "macros.dtsi"
        };

        behaviors {
                tw: tmux_window_hold_tap {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        tapping-term-ms = <200>;
                        quick-tap-ms = <QUICK_TAP_MS>;
                        flavor = "balanced";
                        bindings = <&tmux_window>, <&kp>;
                };
        };

        keymap {
                compatible = "zmk,keymap";
                base_layer {
                        display-name = "BASE";
                        bindings = <
   &none &kp COMMA  &kp U       &kp O         &kp W           &kp Q         &kp K        &kp P        &kp L        &kp F          &kp X        &none
   &none &kp I      &kp E       &kp A         &kp C           &kp Y         &kp B        &kp T        &kp H        &kp S          &kp N        &none
   &none &sk LSHFT  &kp FSLH    &kp DOT       &kp G           &kp APOS      &kp J        &kp D        &kp M        &kp V          &sk RSHFT    &none
                                &sk LCTRL     &lt NAVI SPACE  &sl SYMB      &sl SYMB     &kp R        &sk RCTRL
                        >;
                };
                numb_layer {
                        display-name = "NUMB";
                        bindings = <
   &none &none     &kp EXCL  &kp MINUS &kp PLUS  &kp ASTRK &kp K     &kp AT        &kp LBKT   &kp RBKT  &trans     &none
   &none &kp N6    &kp N4    &kp N0    &kp N2    &kp LS(G) &kp HASH  &kp N3        &kp N1     &kp N5    &kp N7     &none
   &none &kp QMARK &trans    &trans    &kp N8    &trans    &kp J     &kp N9        &kp LT     &kp RT    &kp PRCNT  &none
                             &trans    &trans    &trans    &trans    &kp K_CANCEL  &trans
                        >;
                };
                symb_layer {
                        display-name = "SYMB";
                        bindings = <

   &none &kp TILDE &kp EXCL  &kp MINUS       &kp PLUS  &kp ASTRK  &none     &kp AT        &kp LBKT   &kp RBKT  &none        &none
   &none &kp RBRC  &kp LBRC  &kp DQT         &kp CARET &kp BSLH   &kp HASH  &kp DOLLAR    &kp LPAR   &kp RPAR  &kp GRAVE    &none
   &none &kp QMARK &kp trans &kp UNDER       &kp PIPE  &trans     &none     &kp AMPS      &kp LT     &kp GT    &kp PRCNT    &none
                             &trans          &trans    &trans     &trans    &kp K_CANCEL  &trans
                        >;
                };
                navi_layer {
                        display-name = "NAVI";
                        bindings = <
   &none &kp LG(LS(T)) &kp LEFT        &kp UP           &kp RIGHT   &none     &kp LA(S)  &kp LA(H) &kp LA(J)  &kp LA(K) &kp LA(L) &none
   &none &kp LG(A)     &kp LC(LS(TAB)) &mt LCTRL DOWN   &kp LC(TAB) &none     &kp HOME   &kp H     &kp J      &kp K     &kp L     &none
   &none &kp LG(Z)     &kp LG(X)       &kp LG(C)        &kp LG(V)   &none     &kp END    &kp LC(D) &kp PG_DN  &kp PG_UP &kp LC(U) &none
                                       &trans           &trans      &trans    &trans     &mo WNAV  &trans
                        >;
                };
                wnav_layer {
                        display-name = "WNAV";
                        bindings = <
   &none &none      &none      &none      &none      &none   &none   TMUX_LT     TMUX_DN      TMUX_UP     TMUX_RT    &none
   &none TY(N6)     TY(N4)     TY(N0)     TY(N2)     &none   &none   TY(N3)      TY(N1)       TY(N5)      TY(N7)     &none
   &none &none      &none      &none      TY(N8)     &none   &none   &none       &lca_w       &lca_e      &lca_m     &none
                               &trans     &trans     &trans  &trans  &trans      &trans
                        >;
                };
                medi_layer {
                        display-name = "MEDI";
                        bindings = <
   &none &none     &none     &none     &none     &none       &bt BT_CLR    &none         &kp C_PREV   &kp C_NEXT    &none       &none
   &none &none     &none     &none     &none     &none       &bt BT_SEL 0  &kp C_PP      &kp C_VOL_DN &kp C_VOL_UP  &kp C_MUTE  &none
   &none &none     &none     &none     &none     &none       &bt BT_SEL 1  &kp F13       &kp C_BRI_DN &kp C_BRI_UP  &none       &none
                             &trans    &trans    &trans      &trans        &kp K_CANCEL  &trans
                        >;
                };
        };
};
