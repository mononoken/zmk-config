#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include "corne.h"

/ {
        combos {
                #include "combos.dtsi"
        };

        macros {
                #include "macros.dtsi"
        };

        keymap {
                compatible = "zmk,keymap";
                base_layer {
                        label = "BASE";
                        bindings = <
   &none &kp UNDER &kp C    &kp F     &kp K     &kp B       &kp X     &kp J  &kp O      &kp U    &kp RPAR     &none
   &none &kp R     &kp S    &kp T     &kp H     &kp P       &kp M     &kp N  &kp A      &kp I    &key_repeat  &none
   &none &kp V     &kp W    &kp G     &kp D     &kp LPAR    &kp FSLH  &kp L  &kp COMMA  &kp DOT  &kp Y        &none
                            &none     &sl LSYM  &lt 2 SPACE &kp E     &mo 2  &kp RALT
                        >;
                };
                numb_layer {
                        label = "NUMB";
                        bindings = <
   &none &trans    &kp PLUS &kp ASTRK &kp K  &none       &kp X     &kp J  &kp O      &kp U    &kp RPAR     &none
   &none &kp 6     &kp 4    &kp 0     &kp 2  &trans      &kp M     &kp N  &kp A      &kp I    &key_repeat  &none
   &none &kp PRCNT &none    &kp G     &kp 8  &trans      &kp FSLH  &kp L  &kp COMMA  &kp DOT  &kp Y        &none
                            &kp LGUI  &mo 1  &trans      &kp E     &mo 2  &kp RALT
                        >;
                };
                navi_layer {
                        label = "NAVI";
                        bindings = <
   &none &kp UNDER &kp C    &kp F     &kp K  &kp B       &kp X     &kp J  &kp O      &kp U    &kp RPAR     &none
   &none &kp R     &kp S    &kp T     &kp H  &kp P       &kp M     &kp N  &kp A      &kp I    &key_repeat  &none
   &none &kp V     &kp W    &kp G     &kp D  &kp LPAR    &kp FSLH  &kp L  &kp COMMA  &kp DOT  &kp Y        &none
                            &kp LGUI  &mo 1  &kp SPACE   &kp E     &mo 2  &kp RALT
                        >;
                };
                lsym_layer {
                        label = "LSYM";
                        bindings = <
   &none &kp UNDER &kp PLUS &kp ASTRK &kp K  &kp B       &kp X     &kp J  &kp O      &kp U    &kp RPAR     &none
   &none &kp CARET &kp S    &kp T     &kp H  &kp P       &kp M     &kp N  &kp A      &kp I    &key_repeat  &none
   &none &kp PRCNT &kp LT   &kp GT    &kp D  &kp LPAR    &kp FSLH  &kp L  &kp COMMA  &kp DOT  &kp Y        &none
                            &kp LGUI  &mo 1  &kp SPACE   &kp E     &mo 2  &kp RALT
                        >;
                };
                rsym_layer {
                        label = "RSYM";
                        bindings = <
   &none &kp UNDER &kp C    &kp F     &kp K  &kp B       &kp X     &kp HASH  &kp AT     &kp U    &kp RPAR     &none
   &none &kp R     &kp S    &kp T     &kp H  &kp P       &kp M     &kp N     &kp A      &kp I    &key_repeat  &none
   &none &kp V     &kp W    &kp G     &kp D  &kp LPAR    &kp FSLH  &kp L     &kp COMMA  &kp DOT  &kp Y        &none
                            &kp LGUI  &mo 1  &kp SPACE   &kp E     &mo 2     &kp RALT
                        >;
                };
        };
};
