#include <behaviors.dtsi>
#include <behaviors/num_word.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include "corne.h"
#include "zmk-helpers/helper.h"
#include "zmk-helpers/key-labels/42.h"

/* Globals */

#define QUICK_TAP_MS 175

&sk {
  release-after-ms = <900>;
  quick-release;
};

&lt {
  flavor = "balanced";
  tapping-term-ms = <200>;
  quick-tap-ms = <QUICK_TAP_MS>;
};

#define TW(keycode) &tw keycode keycode

/ {
        combos {
                #include "combos.dtsi"
        };

        macros {
                #include "macros.dtsi"
        };

        behaviors {
                tw: tmux_window_hold_tap {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        tapping_term_ms = <200>;
                        quick_tap_ms = <QUICK_TAP_MS>;
                        flavor = "balanced";
                        bindings = <&tmux_window>, <&kp>;
                };
        };

        keymap {
                compatible = "zmk,keymap";
                base_layer {
                        display-name = "BASE";
                        bindings = <
   &none &kp UNDER   &kp C        &kp F        &kp K           &kp B          &kp X     &kp J       &kp O        &kp U     &kp Y        &none
   &none &kp R       &kp S        &kp T        &kp H           &kp P          &kp M     &kp N       &kp A        &kp I     &key_repeat  &none
   &none &sk LSHFT   &kp W        &kp G        &kp D           &kp V          &kp FSLH  &kp L       &kp COMMA    &kp DOT   &sk RSHFT    &none
                                  &sl SHRT     &sl LSYM        &lt NAVI SPACE &kp E     &sl RSYM    &sl SHRT
                        >;
                };
                numb_layer {
                        display-name = "NUMB";
                        bindings = <
   &none &trans    &kp PLUS &kp ASTRK &kp K  &none   &trans       &kp J  &none   &none    &trans       &none
   &none &kp N6    &kp N4   &kp N0    &kp N2 &trans  &kp BSLH     &kp N3 &kp N1  &kp N5   &kp N7       &none
   &none &kp PRCNT &none    &kp LS(G) &kp N8 &trans  &trans       &kp N9 &trans  &trans   &kp PRCNT    &none
                            &trans    &trans &trans  &kp K_CANCEL &trans &trans
                        >;
                };
                /* Is SYMB actually used? */
                symb_layer {
                        display-name = "SYMB";
                        bindings = <
   &none &trans    &kp PLUS &kp ASTRK &none     &kp RPAR  &none        &kp HASH  &kp AT   &none    &trans       &none
   &none &kp CARET &kp LPAR &kp RPAR  &kp TILDE &none     &kp BSLH     &kp GRAVE &kp LBKT &kp RBKT &kp DOLLAR   &none
   &none &kp PRCNT &kp LT   &kp GT    &kp PIPE  &kp LPAR  &trans       &kp AMPS  &kp LBRC &kp RBRC &kp PRCNT    &trans
                            &trans    &trans    &trans    &kp K_CANCEL &trans    &trans
                        >;
                };
                lsym_layer {
                        display-name = "LSYM";
                        bindings = <
   &none &trans    &kp PLUS &kp ASTRK &none     &kp RPAR  &trans       &kp J          &none   &trans   &trans      &none
   &none &kp CARET &kp LPAR &kp RPAR  &kp TILDE &none     &kp BSLH     TW(N3)         TW(N1)  TW(N5)   TW(N7)      &none
   &none &kp PRCNT &kp LT   &kp GT    &kp PIPE  &kp LPAR  &trans       TW(N9)         &trans  &trans   &kp PRCNT   &none
                            &trans    &trans    &trans    &kp K_CANCEL &num_word NUMB &trans
                        >;
                };
                rsym_layer {
                        display-name = "RSYM";
                        bindings = <
   &none &trans    &kp PLUS &kp ASTRK &kp K          &kp RPAR &none        &kp HASH  &kp AT   &none    &trans       &none
   &none TW(N6)    TW(N4)   TW(N0)    TW(N2)         &trans   &kp BSLH     &kp GRAVE &kp LBKT &kp LBKT &kp DOLLAR   &none
   &none &kp PRCNT &none    &kp LS(G) TW(N8)         &trans   &trans       &kp AMPS  &kp LBRC &kp RBRC &kp PRCNT    &none
                            &trans    &num_word NUMB &trans   &kp K_CANCEL &trans &trans
                        >;
                };
                navi_layer {
                        display-name = "NAVI";
                        bindings = <
   &none &none         &kp LEFT        &kp UP           &kp RIGHT   &kp HOME  &none    &none     &kp LA(S)  &kp LA(G) &none     &none
   &none &kp LG(LS(T)) &kp LC(LS(TAB)) &mt LCTRL DOWN   &kp LC(TAB) &none     &none    &kp H     &kp J      &kp K     &kp L     &none
   &none &none         &none           &kp PG_UP        &kp PG_DN   &kp END   &none    &kp LA(H) &kp LA(J)  &kp LA(K) &kp LA(L) &none
                                       &trans           &trans      &trans    &mo WNAV &trans    &trans
                        >;
                };
                wnav_layer {
                        display-name = "WNAV";
                        bindings = <
   &none &none      &none      &none      &none      &none   &none   &lca_w      &lca_e       &lca_m      &none      &none
   &none &kp LA(N6) &kp LA(N4) &kp LA(N0) &kp LA(N2) &none   &none   &kp LA(N3)  &kp LA(N1)   &kp LA(N5)  &kp LA(N7) &none
   &none &none      &none      &none      &kp LA(N8) &none   &none   TMUX_LT     TMUX_DN      TMUX_UP     TMUX_RT    &none
                               &trans     &trans     &trans  &trans  &trans      &trans
                        >;
                };
                shrt_layer {
                        display-name = "SHRT";
                        bindings = <
   &none &kp LG(Q) &kp LG(W) &kp LG(E) &kp LG(R) &kp LG(T)   &bt BT_CLR    &none       &kp C_PREV   &kp C_NEXT    &none       &none
   &none &kp LG(A) &kp LG(S) &kp LG(D) &kp LG(F) &kp LG(G)   &bt BT_SEL 0  &kp C_PP    &kp C_VOL_DN &kp C_VOL_UP  &kp C_MUTE  &none
   &none &kp LG(Z) &kp LG(X) &kp LG(C) &kp LG(V) &kp LG(B)   &bt BT_SEL 1  &kp F13     &kp C_BRI_DN &kp C_BRI_UP  &none       &none
                             &trans    &trans    &trans      &kp K_CANCEL  &trans      &trans
                        >;
                };
        };
};
