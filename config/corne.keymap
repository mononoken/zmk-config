#include <behaviors.dtsi>
#include <behaviors/num_word.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include "corne.h"
#include "zmk-helpers/helper.h"
#include "zmk-helpers/key-labels/42.h"

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LM0 LM1 LM2 LM3 LM4 LB0 LB1 LB2 LB3 LB4  // Left-hand keys.
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RM0 RM1 RM2 RM3 RM4 RB0 RB1 RB2 RB3 RB4  // Right-hand keys.
#define THUMBS LH2 LH1 LH0 RH0 RH1 RH2                                      // Thumb keys.

/* Left-hand HRMs. */
ZMK_HOLD_TAP(hml,
    flavor = "balanced";
    tapping-term-ms = <280>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
    bindings = <&kp>, <&kp>;
    hold-trigger-key-positions = <KEYS_R THUMBS>;
    hold-trigger-on-release;
)

/* Right-hand HRMs. */
ZMK_HOLD_TAP(hmr,
    flavor = "balanced";
    tapping-term-ms = <280>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
    bindings = <&kp>, <&kp>;
    hold-trigger-key-positions = <KEYS_L THUMBS>;
    hold-trigger-on-release;
)

/ {
        combos {
                #include "combos.dtsi"
        };

        macros {
                #include "macros.dtsi"
        };

        keymap {
                compatible = "zmk,keymap";
                base_layer {
                        label = "BASE";
                        bindings = <
   &none &kp UNDER   &kp C        &kp F        &kp K           &kp B          &kp X     &kp J       &kp O            &kp U          &kp RPAR     &none
   &none &kp R       &kp S        &kp T        &kp H           &kp P          &kp M     &kp N       &kp A            &kp I          &key_repeat  &none
   &none &hml LALT V &hml LCTRL W &hml LSHFT G &hml LGUI D     &kp LPAR       &kp FSLH  &hmr LGUI L &hmr RSHFT COMMA &hmr LCTRL DOT &hmr LALT Y  &none
                                  &sl SHRT     &sl LSYM        &lt NAVI SPACE &kp E     &sl RSYM    &sl SHRT
                        >;
                };
                numb_layer {
                        label = "NUMB";
                        bindings = <
   &none &trans    &kp PLUS &kp ASTRK &kp K  &none   &trans       &kp J  &none  &trans   &kp RPAR     &none
   &none &kp N6    &kp N4   &kp N0    &kp N2 &trans  &kp BSLH     &kp N3 &kp N1 &kp N5   &kp N7        &none
   &none &kp PRCNT &none    &kp G     &kp N8 &trans  &trans       &kp N9 &trans &trans   &kp PRCNT    &trans
                            &trans    &trans &trans  &kp K_CANCEL &trans &trans
                        >;
                };
                symb_layer {
                        label = "SYMB";
                        bindings = <
   &none &trans    &kp PLUS &kp ASTRK &none     &none     &none        &kp HASH  &kp AT     &none    &trans       &none
   &none &kp CARET &kp LBKT &kp RBKT  &kp TILDE &none     &kp BSLH     &kp GRAVE &kp LBRC   &kp RBRC &kp DOLLAR   &none
   &none &kp PRCNT &kp LT   &kp GT    &kp PIPE  &trans    &trans       &kp AMPS  &trans     &trans   &kp PRCNT    &trans
                            &trans    &trans    &trans    &kp K_CANCEL &trans    &trans
                        >;
                };
                lsym_layer {
                        label = "LSYM";
                        bindings = <
   &none &trans    &kp PLUS &kp ASTRK &none     &none     &trans       &kp J          &none  &trans   &kp RPAR    &none
   &none &kp CARET &kp LBKT &kp RBKT  &kp TILDE &none     &kp BSLH     &kp N3         &kp N1 &kp N5   &kp N7      &none
   &none &kp PRCNT &kp LT   &kp GT    &kp PIPE  &trans    &trans       &kp N9         &trans &trans   &kp PRCNT   &none
                            &trans    &trans    &trans    &kp K_CANCEL &num_word NUMB &trans
                        trans
                };
                rsym_layer {
                        label = "RSYM";
                        bindings = <
   &none &trans    &kp PLUS &kp ASTRK &kp K          &none   &none        &kp HASH  &kp AT     &none    &trans       &none
   &none &kp N6    &kp N4   &kp N0    &kp N2         &trans  &kp BSLH     &kp GRAVE &kp LBRC   &kp RBRC &kp DOLLAR   &none
   &none &kp PRCNT &none    &kp G     &kp N8         &trans  &trans       &kp AMPS  &trans     &trans   &kp PRCNT    &none
                            &trans    &num_word NUMB &trans  &kp K_CANCEL &trans &trans
                        >;
                };
                navi_layer {
                        label = "NAVI";
                        bindings = <
   &none &none         &kp LEFT        &kp UP          &kp RIGHT   &kp HOME  &none    &none     &kp LA(S)  &kp LA(G) &none     &none
   &none &kp LG(LS(T)) &kp LC(LS(TAB)) &mt LCTRL DOWN  &kp LC(TAB) &none     &none    &kp H     &kp J      &kp K     &kp L     &none
   &none &none         &none           &kp PG_UP       &kp PG_DN   &kp END   &none    &kp LA(H) &kp LA(J)  &kp LA(K) &kp LA(L) &none
                                       &trans          &trans      &trans    &mo WNAV &trans    &trans
                        >;
                };
                wnav_layer {
                        label = "WNAV";
                        bindings = <
   &none &none      &none      &none      &none      &none   &none   &kp LA(LC(W)) &kp LA(LC(E)) &kp LA(LC(M))  &none      &none
   &none &kp LA(N6) &kp LA(N4) &kp LA(N0) &kp LA(N2) &none   &none   &kp LA(N3)    &kp LA(N1)    &kp LA(N5)     &kp LA(N7) &none
   &none &none      &none      &none      &kp LA(N8) &none   &none   TMUX_LT       TMUX_DN       TMUX_UP        TMUX_RT    &none
                               &trans     &trans     &trans  &trans  &trans        &trans
                        >;
                };
                shrt_layer {
                        label = "SHRT";
                        bindings = <
   &none &kp LG(Q) &kp LG(W) &kp LG(E) &kp LG(R) &kp LG(T)   &none         &none       &kp C_PREV   &kp C_NEXT    &none       &none
   &none &kp LG(A) &kp LG(S) &kp LG(D) &kp LG(F) &kp LG(G)   &none         &kp C_PP    &kp C_VOL_DN &kp C_VOL_UP  &kp C_MUTE  &none
   &none &kp LG(Z) &kp LG(X) &kp LG(C) &kp LG(V) &kp LG(B)   &none         &none       &kp C_BRI_DN &kp C_BRI_UP  &none       &none
                             &trans    &trans    &trans      &kp K_CANCEL  &trans      &trans
                        >;
                };
        };
};
