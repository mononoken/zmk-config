#include <behaviors.dtsi>
#include <behaviors/num_word.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include "corne.h"
#include "zmk-helpers/helper.h"
#include "zmk-helpers/key-labels/42.h"

/* Globals */

#define QUICK_TAP_MS 175

&sk {
  release-after-ms = <900>;
  quick-release;
};

&lt {
  flavor = "balanced";
  tapping-term-ms = <200>;
  quick-tap-ms = <QUICK_TAP_MS>;
};

&num_word {
  continue-list = <BSPC DEL DOT COMMA PLUS MINUS STAR FSLH EQUAL>;
};

#define TW(keycode) &tw keycode keycode
#define RT(keycode) &rt keycode 0

/ {
        combos {
                #include "combos.dtsi"
        };

        macros {
                #include "macros.dtsi"
        };

        behaviors {
                tw: tmux_window_hold_tap {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        tapping-term-ms = <200>;
                        quick-tap-ms = <QUICK_TAP_MS>;
                        flavor = "balanced";
                        bindings = <&tmux_window>, <&kp>;
                };
                rt: repeat_tap {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        flavor = "tap-preferred";
                        tapping-term-ms = <160>;
                        bindings = <&mo>, <&key_repeat>;
                        display-name = "Repeat-Layer-Tap";
                };
        };

        keymap {
                compatible = "zmk,keymap";
                base_layer {
                        display-name = "BASE";
                        bindings = <
   &none &none      &kp P       &kp D         &kp W           &kp F         &kp Q        &kp M        &kp A        &kp U          &none        &none
   &none &kp S      &kp N       &kp T         &kp C           &kp Y         &kp J        &kp H        &kp O        &kp E          &kp I        &none
   &none &kp V      &lt NUMB B  &kp K         &kp G           &kp APOS      &kp X        &kp L        &kp DOT      &lt NUMB FSLH  &kp COMMA    &none
                                &sk LSHFT     &lt NAVI SPACE  &sl SYMB      &key_repeat  &kp R        &sk RSHFT
                        >;
                };
                numb_layer {
                        display-name = "NUMB";
                        bindings = <
   &none &none     &kp LBKT  &kp RBKT  &kp AT    &none     &kp K     &kp PLUS      &kp MINUS  &kp EXCL  &kp TILDE  &none
   &none &kp N6    &kp N4    &kp N0    &kp N2    &kp LS(G) &kp J     &kp N3        &kp N1     &kp N5    &kp N7     &none
   &none &kp PRCNT &kp LT    &kp GT    &kp N8    &none     &kp X     &kp N9        &kp UNDER  &kp ASTRK &kp QMARK  &none
                             &trans    &trans    &trans    &trans    &kp K_CANCEL  &trans
                        >;
                };
                symb_layer {
                        display-name = "SYMB";
                        bindings = <
   &none &none     &kp EXCL  &kp MINUS       &kp PLUS  &none      &none     &kp PLUS      &kp MINUS  &kp EXCL  &kp TILDE    &none
   &none &kp BSLH  &kp LPAR  &kp RPAR        &kp CARET &none      &none     &kp DOLLAR    &kp DQT    &kp LBRC  &kp RBRC     &none
   &none &kp QMARK &kp ASTRK &kp UNDER       &kp PIPE  &kp GRAVE  &none     &kp N9        &none      &none     &none        &none
                             &trans          &trans    &trans     &trans    &kp K_CANCEL  &num_word NUMB
                        >;
                };
   /*              lsym_layer { */
   /*                      display-name = "LSYM"; */
   /*                      bindings = < */
   /* &none &kp TILDE &kp EXCL  &kp MINUS       &kp PLUS  &none      &none     &none         &none      &none     &none        &none */
   /* &none &kp RBRC  &kp LBRC  &kp DQT         &kp CARET &none      &none     &kp N3        &kp N1     &kp N5    &kp N7       &none */
   /* &none &kp QMARK &kp ASTRK &kp UNDER       &kp PIPE  &kp GRAVE  &none     &kp N9        &none      &none     &none        &none */
   /*                           &trans          &trans    &trans     &trans    &kp K_CANCEL  &num_word NUMB */
   /*                      >; */
   /*              }; */
   /*              rsym_layer { */
   /*                      display-name = "RSYM"; */
   /*                      bindings = < */
   /* &none &none     &none     &none           &none      &none      &trans    &kp AT        &kp LBKT        &kp RBKT  &none        &none */
   /* &none &kp N6    &kp N4    &kp N0          &kp N2     &none      &kp HASH  &kp DOLLAR    &kp LPAR        &kp RPAR  &kp BSLH     &none */
   /* &none &none     &none     &none           &kp N8     &none      &trans    &kp AMPS      &kp LT          &kp GT    &kp PRCNT    &none */
   /*                           &num_word NUMB  &trans     &trans     &trans    &kp K_CANCEL  &trans */
   /*                      >; */
   /*              }; */
                navi_layer {
                        display-name = "NAVI";
                        bindings = <
   &none &none         &kp LEFT        &kp UP           &kp RIGHT   &none     &none    &kp LA(H) &kp LA(J)  &kp LA(K) &kp LA(L) &none
   &none &kp LG(LS(T)) &kp LC(LS(TAB)) &mt LCTRL DOWN   &kp LC(TAB) &none     &none    &kp H     &kp J      &kp K     &kp L     &none
   &none &kp LG(Z)     &kp LG(X)       &kp LG(C)        &kp LG(V)   &none     &none    &kp HOME  &kp PG_DN  &kp PG_UP &kp END   &none
                                       &trans           &trans      &trans    &trans   &mo WNAV  &trans
                        >;
                };
                wnav_layer {
                        display-name = "WNAV";
                        bindings = <
   &none &none      &none      &none      &none      &none   &none   TMUX_LT     TMUX_DN      TMUX_UP     TMUX_RT    &none
   &none &kp LA(N6) &kp LA(N4) &kp LA(N0) &kp LA(N2) &none   &none   &kp LA(N3)  &kp LA(N1)   &kp LA(N5)  &kp LA(N7) &none
   &none &none      &none      &none      &kp LA(N8) &none   &none   &none       &lca_w       &lca_e      &lca_m     &none
                               &trans     &trans     &trans  &trans  &trans      &trans
                        >;
                };
                shrt_layer {
                        display-name = "SHRT";
                        bindings = <
   &none &kp LG(Q) &kp LG(W) &kp LG(E) &kp LG(R) &kp LG(T)   &bt BT_CLR    &none         &kp C_PREV   &kp C_NEXT    &none       &none
   &none &kp LG(A) &kp LG(S) &kp LG(D) &kp LG(F) &kp LG(G)   &bt BT_SEL 0  &kp C_PP      &kp C_VOL_DN &kp C_VOL_UP  &kp C_MUTE  &none
   &none &kp LG(Z) &kp LG(X) &kp LG(C) &kp LG(V) &kp LG(B)   &bt BT_SEL 1  &kp F13       &kp C_BRI_DN &kp C_BRI_UP  &none       &none
                             &trans    &trans    &trans      &trans        &kp K_CANCEL  &trans
                        >;
                };
        };
};
